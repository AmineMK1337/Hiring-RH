# LLM provider: "ollama" (local, default) or "groq" (cloud)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434

# Only needed when LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Talent Orbit web app (api/)
# LLM_PROVIDER=demo runs the web app without any LLM (rule-based scores, for rehearsals only)
# Storage: "auto" uses MongoDB on localhost:27017 if it is running, else data/orbit_store.json
STORE=auto
MONGO_URI=mongodb://localhost:27017/
